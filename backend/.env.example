# PulseCortex Platform Environment Variables
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=sqlite://./data/pulsecortex.db

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Webhook Deployment
WEBHOOK_SECRET=generate-a-random-secret-for-github-webhooks
ENABLE_WEBHOOK=true

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=900000

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/pulsecortex-backend.log

# Admin User (Initial setup)
ADMIN_EMAIL=admin@pulsecortex.com
ADMIN_PASSWORD=changeme123
